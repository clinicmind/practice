{
  // Cloudflare Workers static assets. The build output is served as a single-page app:
  // any path that is not a file returns index.html, so deep links such as /m/intake work.
  // Do not add a public/_redirects catch-all: Cloudflare rejects it as a redirect loop.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "practice",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
