{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"]
  },
  "include": ["src", "packages/ai-feedback", "supabase", "scripts", "tests", "e2e", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["supabase/functions/reports/index.ts", "supabase/functions/ai-feedback/index.ts"]
}
